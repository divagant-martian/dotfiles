[global_config]
  handle_size = 10
  tab_position = bottom
  hide_from_taskbar = True
  enabled_plugins = CurrDirOpen, LaunchpadBugURLHandler, LaunchpadCodeURLHandler, APTURLHandler, AutoTheme
  ask_before_closing = never
  case_sensitive = False
  new_tab_after_current_tab = True
[keybindings]
  new_tab = <Primary>k
  go_up = <Primary><Alt>Up
  go_down = <Primary><Alt>Down
  go_left = <Primary><Alt>Left
  go_right = <Primary><Alt>Right
  split_horiz = <Primary><Shift>t
  split_vert = <Primary>t
[profiles]
  [[default]]
    audible_bell = True
    icon_bell = False
    background_color = "#1f1d29"
    background_darkness = 0.8
    background_type = transparent
    font = Fira Code 12
    foreground_color = "#ffffff"
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_infinite = True
    palette = "#403c58:#ea6f91:#9bced7:#f1ca93:#34738e:#c3a5e6:#eabbb9:#faebd7:#6f6e85:#ea6f91:#9bced7:#f1ca93:#34738e:#c3a5e6:#eabbb9:#ffffff"
    use_system_font = False
    bold_is_bright = True
    copy_on_selection = True
  [[rose-pine-dawn]]
    audible_bell = True
    icon_bell = False
    background_color = "#FAF4ED"
    background_darkness = 0.95
    background_type = transparent
    font = Fira Code 12
    foreground_color = "#575279"
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_infinite = True
    palette = "#F2E9DE:#B4637A:#286983:#EA9D34:#56949F:#907AA9:#D7827E:#575279:#9893A5:#B4637A:#286983:#EA9D34:#56949F:#907AA9:#D7827E:#575279"
    use_system_font = False
    bold_is_bright = True
    copy_on_selection = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
  [[AutoTheme]]
    light = rose-pine-dawn
    dark = default
    mode = Auto
    variant = auto
